PORT=3001
WEB_ORIGIN=http://localhost:5173
# Set only to the known number of reverse proxies; direct access must be blocked by deployment.
TRUST_PROXY_HOPS=0
# Cloud Run combined web/API container sets this to true.
SERVE_WEB=false
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Legacy variable name: use a publishable key (sb_publishable_...) as the value.
# An existing legacy anon key is also accepted; never use a secret/service-role key.
# API uses the user's JWT and RLS. A service-role key is NOT needed.
HEALTHCHECK_ENABLED=true
# In-process scheduling is disabled automatically on Cloud Run. Use Scheduler/Jobs.
# Optional token (minimum 32 characters) for an external monitor. Otherwise generated at startup.
# HEALTHCHECK_TOKEN=
