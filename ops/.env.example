# Separate operations credentials. Never copy these into frontend or API env files.
OPS_ENABLED=false
BACKUP_DATABASE_URL=postgresql://backup_role:YOUR_PASSWORD@YOUR_HOST:5432/postgres?sslmode=verify-full
BACKUP_ROOT=C:/private-cash-flow-backups
BACKUP_HOST_ROOT=C:/private-cash-flow-backups
# Container compose mounts this public CA file at /run/secrets/db-ca.pem.
PG_CA_HOST_PATH=C:/certificates/database-ca.pem
# Generate once, keep separately from backups in a secret manager. 64 hexadecimal characters.
BACKUP_KEY_HEX=YOUR_64_HEX_CHARACTERS
PGSSLROOTCERT=C:/certificates/database-ca.pem
PG_DUMP_BIN=pg_dump
PG_RESTORE_BIN=pg_restore
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
STORAGE_ADMIN_KEY=YOUR_SERVER_ONLY_STORAGE_KEY
# A separate empty test database. Same PostgreSQL major, extensions and required Supabase roles.
# It MUST end in _restore_test. Never point to production. A used test DB is refused; prepare a new empty one.
# RESTORE_TEST_DATABASE_URL=postgresql://restore_role:YOUR_PASSWORD@localhost:5432/cash_flow_restore_test
HEALTHCHECK_TOKEN=YOUR_AT_LEAST_32_CHARACTER_RANDOM_TOKEN
MONITOR_API_URL=http://127.0.0.1:3001/api/health/database
